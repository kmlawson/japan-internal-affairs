  {
   "about": "A diplomatic despatch reporting on the executions of February 26 Incident leaders, the termination of martial law in Tokyo, and the dominance of military defense programs over civil reforms.",
   "continues_previous": false,
   "date": "1936-07-22",
   "doc_type": "despatch",
   "end_page": 259,
   "from": "E. R. Dickover",
   "keywords": [
