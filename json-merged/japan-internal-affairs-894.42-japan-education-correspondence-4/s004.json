 "subfiles": [
  {
   "title": "Roster of Japanese Educational Institutions: Miyazaki Prefecture—Introduction, Statistical Tables, and Roster",
   "doc_type": "statistical report and institutional roster",
   "start_page": 193,
   "end_page": 264,
   "continues_previous": true,
   "date": "1946",
   "from": "Civil Information and Education Section, with the Japanese Ministry of Education",
   "to": "",
   "about": "A prefecture-wide census and roster documenting Miyazaki educational institutions, their jurisdiction, addresses, founding dates, enrollment, and teaching staffs in 1946.",
   "summary": "The report explains deficiencies in Japanese educational recordkeeping and describes a project that assembled a national list of more than 40,000 institutions from Ministry of Education, prefectural, local, and individual-school sources. Summary tables classify Miyazaki Prefecture’s schools by level, type, and national, prefectural, municipal, village or town, private, or other-ministry control, using enrollment and teacher figures for 30 April and 30 November 1946. The roster then identifies individual colleges, normal schools, vocational schools, middle schools, girls’ high schools, special schools, youth schools, and elementary schools, normally giving each institution’s address, founding date, enrollment, and staff. The elementary-school roster remains unfinished at page 264 and continues in the next section.",
