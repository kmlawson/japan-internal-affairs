 "section_summary": "This section contains State Department documentation and a comprehensive SCAP Natural Resources Section report regarding the iron and steel metallurgy of Japan, Korea, and Manchuria from 1925 through the end of World War II. It begins with an October 1946 State Department memorandum concerning Far Eastern Commission negotiations over Japan's assured pig iron capacity, followed by a Tokyo political adviser transmittal despatch. The bulk of the section consists of Report No. 50, which details raw material dependencies, major integrated steelworks, emergency wartime production methods, and comprehensive statistical data on iron ore, coal, coke, pig iron, and steel across the former Japanese empire.",
 "subfiles": [
  {
   "about": "A memorandum requesting authority for the U.S. member of the Far Eastern Commission to accept an increase in Japan's assured pig iron capacity.",
   "continues_previous": false,
   "date": "1946-10-04",
   "doc_type": "memorandum",
   "end_page": 1,
   "from": "JK - Mr. Martin and Mr. Hodge",
   "keywords": [
    "pig iron",
    "Far Eastern Commission",
    "SWNCC 236/19",
    "reparations",
    "Pauley report",
    "Japan"
   ],
   "start_page": 1,
   "summary": "Recommends authorizing the U.S. FEC member to accept increasing Japan's assured pig iron capacity to 800,000 metric tons.",
   "title": "Assured Capacity -- Pig Iron",
   "to": "A-H - Mr. Gross"
  },
  {
   "about": "A transmittal despatch enclosing four copies of SCAP Natural Resources Section Report No. 50 on Japanese iron and steel metallurgy.",
   "continues_previous": false,
   "date": "1946-11-24",
   "doc_type": "cover sheet",
   "end_page": 2,
   "from": "United States Political Adviser, Tokyo",
