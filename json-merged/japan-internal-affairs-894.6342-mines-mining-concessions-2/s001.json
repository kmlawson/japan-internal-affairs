 "section_summary": "This section contains a comprehensive voluntary consular report titled 'Silver Developments in Japan' (dated July 5, 1939) prepared by Consular Clerk Helen J. Skouland and approved by Consul L. H. Gourley at the American Consulate in Kobe, Japan. The report surveys Japanese government mobilization and control measures over silver production, pricing, and domestic consumption under the Gold Fund Special Accounts Law, alongside the illicit influx and smuggling of Chinese silver. Accompanied by four extensive statistical attachments, it provides detailed historical data on coinage, annual imperial production across Japan proper, Chosen (Korea), and Taiwan, mine-by-mine outputs and individual ownership for 1935, and international trade flows highlighting substantial silver exports to the United States.",
 "subfiles": [
  {
   "about": "Voluntary consular report on government mobilization, pricing, consumption, production, and exports of silver in the Japanese Empire, including Korea and Taiwan.",
   "continues_previous": false,
   "date": "1939-07-05",
   "doc_type": "voluntary report",
   "end_page": 49,
   "from": "Helen J. Skouland, Consular Clerk (approved by L. H. Gourley, American Consul), American Consulate, Kobe, Japan",
   "keywords": [
    "silver",
    "mining",
    "Gold Fund Special Accounts Law",
    "Bank of Japan",
    "bullion exports",
    "specie reserves",
    "coinage",
    "United States"
   ],
   "start_page": 1,
   "summary": "A voluntary consular report prepared at Kobe detailing Japanese governmental measures to mobilize, curtail domestic consumption of, and centralize silver holdings under the revised Gold Fund Special Accounts Law to bolster international accounts and specie reserves. It examines official price fixing based on London rates, small-denomination paper note circulation replacing silver coins, and mine production expansion across Japan proper, Chosen, and Taiwan under the Teikoku Mining Development Company. The report and its four appended statistical attachments document silver smuggling from China following U.S. silver purchase legislation, imperial mine outputs and individual mine owners for 1935, and rising silver bullion exports directed primarily to the United States via Tokyo.",
   "title": "SILVER DEVELOPMENTS IN JAPAN",
   "to": "Department of State"
  }
 ],
