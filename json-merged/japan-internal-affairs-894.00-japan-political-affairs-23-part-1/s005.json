 ],
 "section_summary": "This section comprises the confidential monthly reports on conditions in Japan prepared by the American Embassy in Tokyo for the months of June and July 1940, accompanied by complete schedules of telegrams and despatches transmitted to Washington. The reports detail mounting international friction over the Sino-Japanese conflict, Japanese aerial bombing raids on Chungking, Anglo-Japanese negotiations resulting in the closure of the Burma route, and Japanese pressure on the Netherlands East Indies and French Indochina. They also trace internal Japanese political crises following the fall of France and Italy's entry into the war, highlighting intense agitation for an Axis alignment, Prince Konoye's resignation from the Privy Council, and the subsequent collapse of the Yonai Cabinet.",
 "subfiles": [
  {
   "about": "Concluding portion of the Tokyo Embassy's monthly report on political, international, and economic conditions in Japan during June 1940, with appended lists of telegrams and despatches.",
   "continues_previous": true,
   "date": "1940-06",
   "doc_type": "report",
   "end_page": 315,
   "from": "American Embassy, Tokyo",
