   "title": "Peace Preservation Law of Japan",
   "doc_type": "translated law",
   "start_page": 365,
   "end_page": 378,
   "continues_previous": true,
   "date": "1941-03-08",
   "from": "",
   "to": "",
   "about": "The law defines political crimes and establishes special criminal procedures and preventive detention.",
   "summary": "Law No. 54 of 1941 penalizes organizations and acts aimed at changing Japan’s national polity or opposing private ownership. It gives prosecutors broad powers over arrest, investigation, and detention, limits defense counsel and appeals, and establishes renewable preventive detention. The concluding provisions address application in Korea and cite a 1941 published source.",
   "keywords": [
    "Peace Preservation Law",
    "political offenses",
    "criminal procedure",
    "preventive detention",
    "Korea"
   ]
  },
  {
   "title": "National Defense Security Law of Japan",
   "doc_type": "translated law",
   "start_page": 379,
   "end_page": 389,
   "continues_previous": false,
   "date": "1941-03-06",
   "from": "",
   "to": "",
   "about": "The law defines state secrets and penalizes disclosure, intelligence gathering, and acts considered harmful to national defense.",
   "summary": "Law No. 49 of 1941 covers diplomatic, financial, economic, and other state secrets, with severe penalties for disclosure and related conduct involving foreign countries. Its procedural chapter expands prosecutorial powers, restricts counsel and appeals, and provides special rules for military courts. Supplementary provisions extend enforcement to Japan Proper, Korea, Taiwan, and Karafuto.",
   "keywords": [
    "state secrets",
    "national defense",
    "espionage",
    "criminal procedure",
    "Korea",
    "Taiwan"
   ]
  },
  {
   "title": "Enforcement Regulations for the Military Secrets Protection Law",
   "doc_type": "translated ordinance",
   "start_page": 390,
   "end_page": 413,
   "continues_previous": false,
   "date": "1939-12-12",
   "from": "War Office",
   "to": "",
   "about": "The ordinance identifies military secrets and regulates observation, photography, aviation, vessels, and access near protected sites.",
   "summary": "War Office Ordinance No. 59 specifies secret information about troops, mobilization, equipment, transport, communications, and military establishments. It prohibits specified surveying, photography, aerial navigation, and foreign-vessel movement without permission. Extensive geographic lists define protected fortress areas and other zones across Japan, Korea, Taiwan, and Karafuto; later articles set out applications, certificates, reporting, confiscation, and fines.",
   "keywords": [
    "military secrets",
    "fortified zones",
    "aerial navigation",
    "photography",
    "foreign vessels",
    "permit procedures"
   ]
  },
  {
   "title": "Law For Safeguarding Secrets of Military Material Resources of Japan",
   "doc_type": "translated law",
   "start_page": 414,
