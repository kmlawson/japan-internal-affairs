   ],
   "start_page": 474,
   "summary": "This document lists seventy-eight telegraphic messages sent by the American Embassy in Tokyo to the Department of State from November 1 to November 30, 1939. The messages report extensively on Japanese-American diplomatic talks, conferences between Ambassador Joseph C. Grew and Foreign Minister Kichisaburo Nomura, and public reactions to Grew's October 19 speech. Other major topics include Anglo-Japanese friction and restrictions at Tientsin, Soviet-Japanese diplomatic exchanges and the Nomonhan border commission, the withdrawal of foreign forces from China, and diplomatic efforts regarding the detention of American citizen Luther Tucker.",
   "title": "Telegrams Sent to the Department During November 1939",
   "to": "Department of State"
  }
