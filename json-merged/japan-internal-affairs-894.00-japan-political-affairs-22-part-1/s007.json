 ],
 "section_summary": "This section contains diplomatic reporting from the U.S. Embassy in Tokyo covering the final months of 1938, consisting of the second half of the monthly report for November 1938 and Despatch No. 3613 transmitting the monthly report for December 1938. The documents record Japan's proclamation of a 'New Order in East Asia', military operations and pacification campaigns following the capture of Hankow and Canton, and increasing friction with the United States and Great Britain over the Open Door, shipping restrictions, and foreign property damage in China. They also detail Japanese domestic political maneuvers under Prime Minister Fumimaro Konoe, the expansion of state economic controls under the National General Mobilization Law, deadlocked fisheries negotiations with the Soviet Union, and diplomatic initiatives involving European and Latin American nations.",
 "subfiles": [
  {
   "about": "Concluding portion of the Tokyo Embassy's monthly report on political, economic, and international conditions in Japan for November 1938.",
   "continues_previous": true,
   "date": "1938-12-20",
   "doc_type": "report",
   "end_page": 402,
   "from": "American Embassy, Tokyo",
   "keywords": [
    "Japan",
    "China",
    "New Order in East Asia",
    "Open Door",
    "Great Britain",
    "National General Mobilization Law",
    "economic control",
    "military operations",
    "Yangtze navigation"
   ],
   "start_page": 371,
   "summary": "This subfile concludes Embassy Report No. 146 for November 1938, covering American representations over Japanese embargoes on wool and hemp, navigation bans on the Yangtze, and numerous bombing and looting damage claims in China. It reviews Japanese military consolidation following the capture of Canton and Hankow, the establishment of official development corporations for China, and diplomatic relations with Great Britain, France, Germany, Italy, Peru, Sweden, Hungary, and the League of Nations. In internal affairs, it analyzes Prime Minister Konoe's November 3 radio proclamation of the 'New Order in East Asia', Finance Minister Ikeda's fiscal plans, and political party movements toward spiritual mobilization. The report finishes with a survey of financial conditions, stock market drops precipitated by Article 11 of the National General Mobilization Law, American oil company discussions, and extensive schedules of despatches and telegrams forwarded to Washington during November.",
   "title": "Report on Conditions in Japan during the Month of November 1938 (Report No. 146)",
   "to": "Department of State"
  },
