    "experimental stations"
   ]
  },
  {
   "title": "Regulations for Fisheries Schools",
   "doc_type": "translated regulations",
   "start_page": 62,
   "end_page": 69,
   "continues_previous": false,
   "date": "1923-04-04",
   "from": "Ministry of Education",
   "to": "",
   "about": "Sets rules for fisheries-school admissions, courses, instruction, facilities and later amendments.",
   "summary": "The translated ordinance sets admission ages and qualifications, course lengths, teaching hours, subjects and practical-training requirements. It permits varied courses, elective and secondary study, and special instruction tied to local needs. Supplementary provisions record amendments through 1937.",
   "keywords": [
