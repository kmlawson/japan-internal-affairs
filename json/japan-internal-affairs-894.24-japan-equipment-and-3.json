 "subfiles": [
  {
   "about": "State Department docket register sheets listing and summarizing documents 776e through 942 filed under decimal file 894.24 concerning army equipment, aviation technology, and strategic material exports to Japan between late 1939 and May 1940.",
   "date": "1940-05",
   "doc_type": "list of papers",
   "end_page": 24,
   "from": "Department of State",
   "keywords": [
    "list of papers",
    "docket register",
    "moral embargo",
    "aviation gasoline",
    "blending agents",
    "molybdenum",
    "scrap iron",
    "petroleum exports",
    "Universal Oil Products",
    "American Committee for Non-Participation in Japanese Aggression",
    "Division of Controls"
   ],
   "start_page": 1,
   "summary": "These continuous administrative docket sheets (Form DS-46, sheets 92 through 114) compile chronological purport entries for diplomatic dispatches, interdepartmental memoranda, and corporate correspondence relating to exports to Japan. Primary topics include the voluntary application of the U.S. 'moral embargo' to high-octane aviation fuel refining processes, catalytic cracking units, and blending agents involving major oil companies such as Universal Oil Products, Phillips Petroleum, Sun Oil, and Standard Oil. The entries also reflect substantial congressional and citizen lobbying demanding an embargo on petroleum, scrap metal, and munitions, alongside repeated State Department replies explaining the lack of statutory authority prior to congressional legislation. In addition, numerous entries track Japanese efforts to circumvent American restrictions by procuring strategic raw materials (including wolfram, tin, and rubber) through Latin America and transshipping items across the Soviet Union.",
   "title": "Department of State List of Papers for Decimal File 894.24, Sub-numbers 776e to 942",
   "to": "Department of State"
  },
  {
   "about": "State Department Far Eastern Affairs memorandum summarizing British intelligence from seized corporate records regarding military fortification and infrastructure work in the Pacific and Southeast Asia by the Nanyo Development Company.",
   "date": "1941-04-23",
   "doc_type": "memorandum",
   "end_page": 26,
   "from": "Schmidt",
   "keywords": [
    "Nanyo Kohatsu Kaisha",
    "Nanyo Development Company",
    "Mandated Islands",
    "Inner-Nanyo",
    "Manokwari",
    "New Guinea",
    "Malakal Island",
    "Palau",
    "Spratly Islands",
    "Hainan Island",
    "oil tanks",
    "southward expansion",
    "naval fortifications"
   ],
   "start_page": 25,
   "summary": "Memo reviews seized Nanyo Kohatsu Kaisha archives from Dutch New Guinea, revealing Japanese Navy-backed construction of naval quays and fuel tanks across the Mandated Islands, Hainan, and the Spratlys.",
   "title": "Memorandum by Schmidt (FE) to Hornbeck regarding British Despatch on the Japanese Nanyo Development Company (Nanyo Kohatsu Kaisha)",
   "to": "Stanley K. Hornbeck"
  }
